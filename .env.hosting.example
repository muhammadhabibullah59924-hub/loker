# Template .env untuk hosting publik (InfinityFree).
# Salin menjadi berkas .env di folder proyek di hosting, lalu isi nilai yang
# diberikan panel hosting. Jangan commit berkas .env yang sudah terisi.
# Nilai rahasia: APP_KEY dan DB_PASSWORD.

APP_NAME=LokerDekat
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lokerdekat.rf.gd/loker

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=ISI_HOST_MYSQL_DARI_PANEL
DB_PORT=3306
DB_DATABASE=ISI_NAMA_DATABASE
DB_USERNAME=ISI_USER_DATABASE
DB_PASSWORD=ISI_PASSWORD_DATABASE
DB_CHARSET=utf8
DB_COLLATION=utf8_general_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@lokerdekat.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
